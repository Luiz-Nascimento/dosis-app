# Copie para backend/.env e ajuste. Vale para o runserver e para o Docker
# (no Docker, DJANGO_DEBUG é sempre False e as chaves vazias são geradas no volume).

# Django
# Vazia: chave de desenvolvimento no runserver; no Docker, gerada no volume.
# Gere uma com: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# 10.0.2.2 = computador visto de dentro do emulador Android
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Firebase
# mock     -> Auth e Firestore simulados, sem credenciais (padrão)
# firebase -> projeto real (ou emuladores, se *_EMULATOR_HOST estiverem definidos)
FIREBASE_MODE=mock
# Configurações do projeto > Geral > ID do projeto
FIREBASE_PROJECT_ID=dosis-app
# Configurações do projeto > Geral > Chave de API da Web
FIREBASE_WEB_API_KEY=
# JSON da service account (Configurações do projeto > Contas de serviço),
# relativo a backend/. A pasta secrets/ é ignorada pelo git.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
# Emuladores locais (firebase emulators:start, na pasta backend/firebase/)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Chave AES-256 dos campos sensíveis (32 bytes em base64). Gere com:
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Se trocar a chave, os dados já cifrados deixam de abrir.
FIELD_ENCRYPTION_KEY=

# Sincronização: False aceita lote em texto puro (só para testar no Swagger)
SYNC_REQUIRE_ENCRYPTION=True
SYNC_WIFI_ONLY=True

# Opcional: arquivo para os dados do modo mock sobreviverem a reinícios
# (no Docker fica no volume, em /data/mock_store.json)
MOCK_STORE_PATH=.mock_store.json

# Cloudflare: só para o túnel com URL fixa (docker compose up -d api tunnel-named)
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_HOSTNAME=api.seudominio.com
