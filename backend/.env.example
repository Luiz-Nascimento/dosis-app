# Copie para backend/.env e ajuste.

# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
# 10.0.2.2 = computador visto de dentro do emulador Android
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Firebase
# mock     -> Auth e Firestore simulados, sem credenciais (padrão)
# firebase -> projeto real (ou emuladores, se *_EMULATOR_HOST estiverem definidos)
FIREBASE_MODE=mock
FIREBASE_PROJECT_ID=dosis-app
# Configurações do projeto > Geral > Chave de API da Web
FIREBASE_WEB_API_KEY=
# Caminho do JSON da service account (Configurações do projeto > Contas de serviço)
FIREBASE_CREDENTIALS=
# Emuladores locais (firebase emulators:start, na pasta firebase/)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Chave AES-256 dos campos sensíveis (32 bytes em base64). Gere com:
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Se trocar a chave, os dados já cifrados deixam de abrir.
FIELD_ENCRYPTION_KEY=

# Opcional: arquivo para os dados do modo mock sobreviverem a reinícios
MOCK_STORE_PATH=.mock_store.json
