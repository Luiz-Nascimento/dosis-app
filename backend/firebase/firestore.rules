rules_version = '2';

// Regras de segurança do Firestore do Dosis.
//
// O backend Django acessa o Firestore pelo Admin SDK, que não passa por estas
// regras. Elas existem como defesa em profundidade contra acesso direto de
// clientes (ex.: alguém usando o SDK do Firebase com o próprio token):
//   * cada usuário só lê a própria árvore users/{uid};
//   * catálogo e artigos podem ser lidos por qualquer usuário autenticado;
//   * nenhum cliente escreve direto: toda escrita passa pela API, que valida
//     os dados e criptografa os campos sensíveis;
//   * qualquer caminho não listado aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{collection}/{docId} {
        allow read: if isOwner(uid) && collection in [
          'diagnostics',
          'routine_items',
          'dose_logs',
          'symptom_logs',
          'hydration_logs'
        ];
        allow write: if false;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
